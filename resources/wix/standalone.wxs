<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="GlideWM"
    Version="$(var.VERSION_NUMBER)"
    UpgradeCode="97878f01-fb80-4f7f-9deb-638c77a8bc22"
    Manufacturer="Jassim Alhumaid"
    Language="1033"
    Scope="perMachine"
  >
    <!--
      Reinstall all files; rewrite all registry entries; reinstall all shortcuts.
      Ref: https://docs.microsoft.com/en-us/windows/win32/msi/reinstallmode
    -->
    <Property Id="REINSTALLMODE" Value="amus" />

    <!-- Allow version downgrades. -->
    <MajorUpgrade Schedule="afterInstallInitialize" AllowDowngrades="yes" />

    <!-- Set icon used by installer. -->
    <Icon Id="Custom_Ico" SourceFile="resources/assets/icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="Custom_Ico" />

    <!-- Enable CAB embed, otherwise, a separate .cab file is created. -->
    <MediaTemplate EmbedCab="yes" />

		<UIRef Id="Custom_UI" />

    <!-- User input variables for whether to install shortcuts. -->
    <Property Id="ENABLE_DESKTOP_SHORTCUT" Secure="yes" />
    <Property Id="ENABLE_START_MENU_SHORTCUT" Value="1" Secure="yes" />

    <Feature Id="Custom_ProductFeature">
      <ComponentRef Id="Custom_CreateInstallDir" />
      <ComponentRef Id="Custom_InstallRootFiles" />
      <ComponentRef Id="Custom_InstallCliFiles" />
      <ComponentRef Id="Custom_AddDesktopShortcut" />
      <ComponentRef Id="Custom_AddStartMenuShortcut" />
      <ComponentRef Id="Custom_AddPathEnv" />
      <ComponentRef Id="Custom_RemoveAutoLaunchRegistry" />
    </Feature>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="GlideWM">
        <Component Id="Custom_CreateInstallDir">
          <RegistryValue
            Root="HKLM"
            Key="SOFTWARE\GlideWM"
            Name="InstallDir"
            Value="[INSTALLFOLDER]"
            Type="string"
            KeyPath="yes"
          />
        </Component>

        <!-- Add main + watcher executable. -->
        <Component Id="Custom_InstallRootFiles" Guid="e74a12d4-2de4-47ee-9544-51a00018e5cd">
          <File Id="Custom_RootExe" Source="$(var.EXE_DIR)/glidewm.exe" KeyPath="yes" />
          <File Id="Custom_RootWatcherExe" Source="$(var.EXE_DIR)/glidewm-watcher.exe" />
        </Component>

        <!-- Add CLI executable. -->
        <Directory Id="Custom_CliDir" Name="cli">
          <Component Id="Custom_InstallCliFiles" Guid="b5584ad7-70a3-4d0a-a736-681357f02e2d">
            <File Id="Custom_CliExe" Source="$(var.EXE_DIR)/glidewm-cli.exe" Name="glidewm.exe" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- Add shortcut to desktop. -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="Custom_AddDesktopShortcut" Condition="ENABLE_DESKTOP_SHORTCUT = 1">
        <Shortcut
          Id="Custom_DesktopShortcut"
          Name="GlideWM"
          Description="Launch GlideWM"
          Target="[INSTALLFOLDER]glidewm.exe"
        />

        <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\GlideWM"
          Name="DesktopShortcutInstalled"
          Type="integer"
          Value="1"
          KeyPath="yes"
        />
      </Component>
    </StandardDirectory>

    <!-- Add shortcut to Start Menu. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="Custom_AddStartMenuShortcut" Condition="ENABLE_START_MENU_SHORTCUT = 1">
        <Shortcut
          Id="Custom_StartMenuShortcut"
          Name="GlideWM"
          Description="Launch GlideWM"
          Target="[INSTALLFOLDER]glidewm.exe"
        />

        <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\GlideWM"
          Name="StartMenuShortcutInstalled"
          Type="integer"
          Value="1"
          KeyPath="yes"
        />
      </Component>
    </StandardDirectory>

    <!-- Add CLI directory to PATH. -->
    <Component Id="Custom_AddPathEnv" Guid="726ff976-09f2-41bd-b0ea-877058fbf5f1" KeyPath="yes">
      <Environment
        Id="Custom_PathEnv"
        Value="[INSTALLFOLDER]\cli"
        Name="PATH"
        Permanent="no"
        Part="first"
        Action="set"
        System="yes"
      />
    </Component>

    <!-- Remove auto-launch registry values on uninstall. -->
    <Component Id="Custom_RemoveAutoLaunchRegistry" Guid="2d3bf9ac-a44a-4d9c-be05-a49b9367659c">
      <!-- `RegistryValue` with `KeyPath="yes"` is needed for component state tracking. -->
      <RegistryValue
        Root="HKLM"
        Key="SOFTWARE\GlideWM"
        Name="AutoLaunchCleanup"
        Type="integer"
        Value="1"
        KeyPath="yes"
      />
      <RemoveRegistryValue
        Root="HKCU"
        Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
        Name="GlideWM" />
      <RemoveRegistryValue
        Root="HKCU"
        Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\StartupApproved\Run"
        Name="GlideWM" />
    </Component>
  </Package>
</Wix>
