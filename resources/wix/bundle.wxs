<Wix
  xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
  xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="GlideWM" Version="$(var.VERSION_NUMBER)"
    UpgradeCode="b820b1c1-e464-4107-b0e2-c672e4367bc6"
    Manufacturer="Jassim Alhumaid"
    DisableModify="yes"
    DisableRemove="yes"
    IconSourceFile="resources/assets/icon.ico"
  >
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        LicenseUrl=""
        Theme="hyperlinkSidebarLicense"
        ThemeFile="resources/wix/bundle-theme.xml"
        LocalizationFile="resources/wix/bundle-theme.wxl"
        SuppressOptionsUI="yes"
        ShowVersion="yes" />
    </BootstrapperApplication>

    <!-- User input variable for whether to install GlideWM. -->
    <Variable Name="Custom_InstallGlideWM" Type="numeric" Value="1" bal:Overridable="yes" />

    <Chain>
      <!-- GlideWM MSI for x64 architectures. -->
      <MsiPackage
        Id="Custom_GlideWMPackageX64"
        SourceFile="out/installer-x64.msi"
        InstallCondition="(VersionNT64 AND NOT NativeMachine) OR (NativeMachine = 34404)"
        bal:DisplayInternalUICondition="1"
        Permanent="yes"
      />

      <!-- GlideWM MSI for arm64 architectures. -->
      <MsiPackage
        Id="Custom_GlideWMPackageArm64"
        SourceFile="out/installer-arm64.msi"
        InstallCondition="NativeMachine = 43620"
        bal:DisplayInternalUICondition="1"
        Permanent="yes"
      />
    </Chain>
  </Bundle>
</Wix>
